# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here

# Deployments - Source Models (current, for comparison)
GPT4O_DEPLOYMENT=gpt-4o
GPT4O_MINI_DEPLOYMENT=gpt-4o-mini

# Deployments - Target Models (migration destinations)
GPT41_DEPLOYMENT=gpt-4.1
GPT41_MINI_DEPLOYMENT=gpt-4.1-mini
GPT51_DEPLOYMENT=gpt-5.1
GPT52_DEPLOYMENT=gpt-5.2
GPT5_DEPLOYMENT=gpt-5
GPT5_MINI_DEPLOYMENT=gpt-5-mini
GPT54_DEPLOYMENT=gpt-5.4
GPT54_MINI_DEPLOYMENT=gpt-5.4-mini
GPT55_DEPLOYMENT=gpt-5.5
GPT56_SOL_DEPLOYMENT=gpt-5.6-sol
GPT56_TERRA_DEPLOYMENT=gpt-5.6-terra
GPT56_LUNA_DEPLOYMENT=gpt-5.6-luna
GPT_CHAT_LATEST_DEPLOYMENT=gpt-chat-latest
O3_DEPLOYMENT=o3
O4_MINI_DEPLOYMENT=o4-mini

# Azure AI Foundry (for cloud-based evaluation)
AZURE_AI_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/proj-default

# LLM-as-Judge model (used for evaluation scoring)
EVAL_MODEL_DEPLOYMENT=gpt-4.1
# Model deployment name for Foundry cloud evaluation (defaults to EVAL_MODEL_DEPLOYMENT)
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1
