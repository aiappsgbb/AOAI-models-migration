# Azure OpenAI Configuration
# Copy this file to .env and fill in your values

AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-aoai-api-key>

# Optional: separate endpoint for Realtime (S2S) and TTS voice models.
# Leave empty to reuse AZURE_OPENAI_ENDPOINT.  Auth via Entra ID only.
AZURE_OPENAI_REALTIME_ENDPOINT=

# Microsoft Foundry Evaluation (optional)
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-endpoint>/api/projects/<your-project-name>
# Authentication uses DefaultAzureCredential — picks credentials in this order:
#   1. EnvironmentCredential  (AZURE_TENANT_ID + AZURE_CLIENT_ID + AZURE_CLIENT_SECRET below)
#   2. AzureCliCredential     (az login — available if Azure CLI is installed)
#   3. ManagedIdentityCredential (Azure-hosted environments only)
#
# ── For Docker / Container deployments (required) ──────────────────────────
# Option A: Set a Service Principal (recommended for containers & CI/CD).
#   Create one with:  az ad sp create-for-rbac --name "model-migration-eval"
#   Then grant it "Cognitive Services OpenAI Contributor" on your AI resource.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
#
# Option B: Run 'az login --use-device-code' inside the container:
#   docker exec -it model-migration-eval az login --use-device-code

# ── Authentication (optional) ──────────────────────────────────────────────
# These env vars OVERRIDE the equivalent settings.yaml values at runtime,
# so you can change them from the Azure Portal (Container App → Env vars)
# without rebuilding the image.
AUTH_CODE_VERIFICATION=        # "true" = full OTP flow, "false" = email-only sign-in
AUTH_EMAIL_PROVIDER=            # "console" = print to stdout, "smtp" = SMTP, "msgraph" = Microsoft Graph API
AUTH_EASYAUTH_AUTO_LOGIN=      # "true" (default) = auto sign-in via EasyAuth headers, "false" = always show login page

# When AUTH_EMAIL_PROVIDER (or settings.yaml email_provider) is "smtp":
SMTP_HOST=smtp.office365.com
SMTP_USERNAME=noreply@yourdomain.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com

# When AUTH_EMAIL_PROVIDER is "msgraph" (uses DefaultAzureCredential for auth):
MSGRAPH_FROM_EMAIL=noreply@yourdomain.com

# ── RBAC auto-assign (optional) ──────────────────────────────────────────────
# When true, assigns "Reader" + "Azure AI User" roles on the AI Foundry
# resource to Azure AD users on first login so they can view evaluations
# in the Foundry portal.  Requires: SP with "User Access Administrator"
# role + Graph "User.Read.All" application permission (admin-consented).
AUTO_ASSIGN_FOUNDRY_READER=                 # "true" to enable, empty/false to disable
FOUNDRY_RESOURCE_ID=                         # Full ARM resource ID of the AI Services account
                                             # e.g. /subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<name>
                                             # Find it with: az resource list --name <account-name> --query "[0].id" -o tsv

# ── Google Gemini (optional — only needed if using Gemini models) ────────────
GEMINI_API_KEY=                             # Get from https://aistudio.google.com/

# Flask session secret key (random hex string, auto-generated if empty)
FLASK_SECRET_KEY=
